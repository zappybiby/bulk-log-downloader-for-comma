{
  "manifest_version": 3,
  "name": "Useradmin Route Log Downloader",
  "version": "1.0.0",
  "description": "Download selected comma.ai useradmin route log files into local folders.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Useradmin Route Log Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://useradmin.comma.ai/*",
    "https://commadata2.blob.core.windows.net/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://useradmin.comma.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ]
}
