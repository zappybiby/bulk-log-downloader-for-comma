    "parseMs": "2 + 0.12 * segments; a single serial parser, assumed rather than measured.",
    "list": "100 routes/page; sequential page discovery; 12000 + 400 * routes bytes/page.",
    "cache": {
      "initiallyPresentFraction": 0.95,
